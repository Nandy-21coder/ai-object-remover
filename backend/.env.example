# ==============================================================================
# AI Object Remover - Environment Configuration
# ==============================================================================
# Configure your real AI inpainting provider credentials below.
# Supported AI_PROVIDER values:
#   - stability    : Stability AI Stable Image Inpaint (default)
#   - replicate    : Replicate Inpainting API / SDK
#   - clipdrop     : Clipdrop Cleanup API
#   - fal          : Fal.ai Fast SD / Flux Inpaint
#   - huggingface  : Hugging Face Inference API
#
# Do NOT commit actual secret API keys to version control.
# ==============================================================================

AI_PROVIDER=stability
AI_API_KEY=
AI_MODEL=

# Server Configuration
HOST=127.0.0.1
PORT=8000
API_TIMEOUT_SECONDS=60
MAX_IMAGE_DIMENSION=2048

# Mask Preprocessing & Quality Settings
MASK_EXPANSION_PIXELS=4
MASK_FEATHER_RADIUS=2.0
MAX_RETRIES=2
