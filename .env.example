# ==============================================================================
# AI Object Remover - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual '.env' file or secret API keys to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Inpainting Provider Configuration
# ------------------------------------------------------------------------------
# Supported AI_PROVIDER values:
#   - stability    : Stability AI Stable Image Inpaint API (cloud)
#   - replicate    : Replicate Inpainting API / SDK (cloud)
#   - clipdrop     : Clipdrop Cleanup API (cloud)
#   - fal          : Fal.ai Fast SD / Flux Inpaint (cloud)
#   - huggingface  : Hugging Face Inference API (cloud)
#   - lama         : LaMa Deep Learning Model (local offline - free, no API key needed)
AI_PROVIDER=stability

# Your API key for the chosen cloud provider (leave blank if using 'lama' offline mode)
AI_API_KEY=your_api_key_here

# Optional model override (leave empty for provider defaults)
AI_MODEL=

# Provider-specific fallback keys (optional alternatives to AI_API_KEY):
# STABILITY_API_KEY=your_stability_key_here
# REPLICATE_API_TOKEN=your_replicate_token_here
# CLIPDROP_API_KEY=your_clipdrop_key_here
# FAL_KEY=your_fal_key_here
# HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
API_TIMEOUT_SECONDS=60
MAX_IMAGE_DIMENSION=2048

# ------------------------------------------------------------------------------
# 3. Mask Preprocessing & Quality Settings
# ------------------------------------------------------------------------------
MASK_EXPANSION_PIXELS=4
MASK_FEATHER_RADIUS=2.0
MAX_RETRIES=2
