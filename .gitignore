# ==============================================================================
# AI Object Remover — Project Git Ignore Rules
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache Artifacts
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*$py.class
*.so

# Pytest & Test Execution Caches
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# Environment Variables & Secrets (Never commit .env files)
.env
.env.*
!.env.example
*.env
*.pem
*.key

# Temporary Files, Logs & Backups
*.log
*.tmp
*.temp
*~
*.swp
*.bak
*.pid

# Temporary Test Output Images
test_*_out.png
*.out.png
test_lama_out.png

# Generated Benchmarks & Results
benchmarks/*.csv
results.csv
image_quality_results.csv

# Large AI Model Weights (Offline LaMa ONNX model)
*.onnx

# IDE & Editor Settings
.vscode/
.idea/
pyrightconfig.json
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
